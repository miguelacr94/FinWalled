datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_USERS")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-users"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
